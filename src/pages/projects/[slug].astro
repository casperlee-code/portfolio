---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Layout title={project.data.title} description={`${project.data.category} — ${project.data.year}`}>
  <!-- Hidden data for password protection -->
  <input type="hidden" id="project-id-data" value={project.id} />
  <input type="hidden" id="project-password-data" value={project.data.password || ""} />

  <!-- Glassmorphism Password Protection Modal -->
  {project.data.password && (
    <div 
      id="password-overlay" 
      class="fixed inset-0 z-50 flex items-center justify-center bg-white/75 backdrop-blur-md transition-all duration-500 ease-in-out"
    >
      <div class="max-w-md w-full mx-6 bg-white border border-neutral-100 p-8 md:p-10 shadow-2xl rounded-none flex flex-col text-center">
        <span class="text-[10px] tracking-[0.25em] uppercase text-neutral-400 font-semibold mb-4 block">
          Protected Project
        </span>
        <h2 class="text-xl md:text-2xl font-light tracking-tight font-display text-neutral-900 mb-6">
          請輸入密碼以查看實習專案
        </h2>
        <form id="password-form" class="space-y-4">
          <input 
            type="password" 
            id="project-password-input" 
            placeholder="Password" 
            class="w-full border-b border-neutral-300 py-3 px-1 text-sm text-neutral-900 focus:outline-none focus:border-neutral-900 bg-transparent text-center font-mono placeholder:text-neutral-300 rounded-none transition-colors"
            required
          />
          <p id="password-error" class="text-xs text-red-500 font-light hidden">
            密碼不正確，請再試一次
          </p>
          <button 
            type="submit" 
            class="w-full bg-[#1A1A1A] hover:bg-neutral-800 text-white text-[10px] tracking-[0.2em] uppercase py-4 font-semibold transition-all duration-300 rounded-none cursor-pointer focus:outline-none"
          >
            Verify Password
          </button>
        </form>
      </div>
    </div>
  )}

  <div 
    id="project-content" 
    class="relative w-full min-h-screen flex flex-col md:flex-row bg-white overflow-x-hidden transition-all duration-500"
  >
    
    <!-- Left: Image Gallery -->
    <div 
      id="gallery-container"
      class="w-full md:w-2/3 h-auto md:h-screen md:overflow-y-auto hide-scrollbar pt-24 pb-12 px-4 md:px-12 flex flex-col gap-6 md:gap-10 transition-all duration-500 ease-in-out border-r border-neutral-50"
    >
      {project.data.images.map((img, idx) => (
        <Image 
          src={img} 
          alt={`${project.data.title} - Image ${idx + 1}`} 
          class="w-full object-cover aspect-[16/10] md:aspect-auto hover:opacity-95 transition-opacity duration-300 bg-neutral-50"
          loading={idx === 0 ? "eager" : "lazy"}
          fetchpriority={idx === 0 ? "high" : undefined}
          format="avif"
          widths={[400, 800, 1200]}
          sizes="(max-width: 768px) 100vw, 66vw"
        />
      ))}
    </div>

    <!-- Right: Text Panel -->
    <div 
      id="text-panel"
      class="fixed bottom-0 left-0 w-full h-[70vh] md:h-screen md:w-1/3 md:top-0 md:right-0 md:left-auto bg-white/90 backdrop-blur-md border-t md:border-t-0 md:border-l border-neutral-100 z-40 flex flex-col pt-8 pb-12 px-6 md:pt-28 md:px-10 overflow-y-auto transition-transform duration-500 ease-in-out translate-y-full md:translate-y-0 md:translate-x-0 shadow-2xl md:shadow-none rounded-t-2xl md:rounded-none"
    >
      <!-- Close Button -->
      <button 
        id="close-btn"
        class="absolute top-6 right-6 md:top-8 md:right-8 text-neutral-400 hover:text-[#1A1A1A] transition-colors duration-300 p-2 cursor-pointer focus:outline-none"
        aria-label="Close details"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>

      <!-- Meta Info -->
      <div class="mb-6">
        <span class="text-[10px] tracking-[0.25em] uppercase text-neutral-400 font-semibold block mb-2">
          {project.data.category} — {project.data.year}
        </span>
        <h1 class="text-2xl md:text-3xl font-light tracking-tight font-display text-neutral-900 leading-tight">
          {project.data.title}
        </h1>
      </div>

      <!-- Description / Content -->
      <div class="description-content text-base font-normal text-neutral-600 leading-relaxed space-y-4 max-w-none">
        <Content />
      </div>

      <!-- PDF Button -->
      {project.data.pdf && (
        <div class="mt-8 border-t border-neutral-100 pt-6">
          <a 
            href={`${import.meta.env.BASE_URL}${project.data.pdf.slice(1)}`}
            target="_blank" 
            rel="noopener noreferrer" 
            class="inline-block border border-neutral-900 text-neutral-900 hover:bg-neutral-900 hover:text-white text-[10px] tracking-[0.25em] uppercase px-6 py-3.5 font-semibold transition-all duration-300 rounded-none w-full text-center"
          >
            南鐵車道橋面過程發展
          </a>
        </div>
      )}

      <!-- Back Button -->
      <div class="mt-auto pt-12">
        <a 
          href={`${import.meta.env.BASE_URL}projects`} 
          class="inline-flex items-center gap-2 text-xs tracking-[0.15em] uppercase text-neutral-400 hover:text-[#1A1A1A] transition-colors duration-300"
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
          </svg>
          Back to Projects
        </a>
      </div>
    </div>

    <!-- Floating Info Button (Visible when panel is closed/minimized) -->
    <button 
      id="info-btn"
      class="fixed bottom-6 right-6 z-50 bg-[#1A1A1A] text-white hover:bg-neutral-800 px-5 py-3 text-[10px] tracking-[0.2em] uppercase transition-all duration-300 cursor-pointer shadow-lg opacity-0 pointer-events-none md:shadow-md"
    >
      Info
    </button>

  </div>
</Layout>

<style>
  /* Hide scrollbar for Chrome, Safari and Opera */
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  /* Hide scrollbar for IE, Edge and Firefox */
  .hide-scrollbar {
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
  }

  /* Scoped typography for markdown content */
  .description-content :global(p:first-of-type) {
    font-size: 1rem;     /* text-base */
    font-weight: 500;    /* font-medium */
    color: #262626;      /* text-neutral-800 */
    line-height: 1.75;
  }
  
  .description-content :global(.project-meta),
  .description-content :global(.project-meta p) {
    font-size: 1rem;     /* text-base */
    font-weight: 500;    /* font-medium */
    font-style: italic;  /* italic */
    color: #262626;      /* text-neutral-800 */
    line-height: 1.75;
  }
  
  .description-content :global(h2) {
    font-size: 1.125rem; /* text-lg */
    font-weight: 500;    /* font-medium */
    color: #171717;      /* text-neutral-900 */
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    letter-spacing: -0.025em;
  }

  .description-content :global(h3) {
    font-size: 0.875rem; /* text-sm */
    font-weight: 600;
    color: #171717;      /* text-neutral-900 */
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .description-content :global(ul) {
    list-style-type: disc;
    padding-left: 1.25rem;
    margin-top: 1rem;
    margin-bottom: 1rem;
    font-size: 0.875rem; /* text-sm */
    font-weight: 300;     /* font-light */
  }

  .description-content :global(ol) {
    list-style-type: decimal;
    padding-left: 1.25rem;
    margin-top: 1rem;
    margin-bottom: 1rem;
    font-size: 0.875rem; /* text-sm */
    font-weight: 300;     /* font-light */
  }

  .description-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .description-content :global(table) {
    width: 100%;
    font-size: 0.75rem; /* text-xs */
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
    border-collapse: collapse;
  }

  .description-content :global(th) {
    border-bottom: 1px solid #e5e5e5;
    padding-bottom: 0.5rem;
    text-align: left;
    font-weight: 600;
    color: #171717;
  }

  .description-content :global(td) {
    border-bottom: 1px solid #f5f5f5;
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
    color: #525252;
  }

  .description-content :global(hr) {
    border: 0;
    border-top: 1px solid #f5f5f5;
    margin-top: 2rem;
    margin-bottom: 2rem;
  }

  .description-content :global(blockquote) {
    border-left: 2px solid #e5e5e5;
    padding-left: 1rem;
    font-style: italic;
    color: #737373;
  }
</style>

<script>
  // Password protection logic
  const overlay = document.getElementById('password-overlay');
  const form = document.getElementById('password-form') as HTMLFormElement | null;
  const input = document.getElementById('project-password-input') as HTMLInputElement | null;
  const errorMsg = document.getElementById('password-error');
  const contentContainer = document.getElementById('project-content');
  const projectIdEl = document.getElementById('project-id-data') as HTMLInputElement | null;
  const projectPasswordEl = document.getElementById('project-password-data') as HTMLInputElement | null;

  let isLocked = false;

  if (projectIdEl && projectPasswordEl) {
    const projectId = projectIdEl.value;
    const correctPassword = projectPasswordEl.value;

    if (correctPassword) {
      const storageKey = `unlocked_project_${projectId}`;
      
      const unlock = () => {
        isLocked = false;
        overlay?.classList.add('opacity-0', 'pointer-events-none');
        setTimeout(() => {
          overlay?.remove();
        }, 500);
        contentContainer?.classList.remove('blur-md', 'opacity-10', 'pointer-events-none', 'select-none');
      };

      if (sessionStorage.getItem(storageKey) === 'true') {
        unlock();
      } else {
        isLocked = true;
        contentContainer?.classList.add('blur-md', 'opacity-10', 'pointer-events-none', 'select-none');
        
        form?.addEventListener('submit', (e) => {
          e.preventDefault();
          if (input?.value === correctPassword) {
            sessionStorage.setItem(storageKey, 'true');
            unlock();
          } else {
            if (errorMsg) {
              errorMsg.classList.remove('hidden');
            }
            if (input) {
              input.value = '';
              input.focus();
            }
          }
        });
      }
    }
  }

  const textPanel = document.getElementById('text-panel');
  const galleryContainer = document.getElementById('gallery-container');
  const closeBtn = document.getElementById('close-btn');
  const infoBtn = document.getElementById('info-btn');

  if (textPanel && galleryContainer && closeBtn && infoBtn) {
    // Check screen size
    const isMobile = () => window.innerWidth < 768;

    function initLayout() {
      if (isMobile()) {
        // Mobile initial state: Panel hidden (translate-y-full), Info visible
        textPanel.classList.add('translate-y-full');
        textPanel.classList.remove('translate-y-0', 'md:translate-x-0', 'md:translate-x-full');
        // Only show info button if page is not locked
        if (!isLocked) {
          infoBtn.classList.remove('opacity-0', 'pointer-events-none');
          infoBtn.classList.add('opacity-100', 'pointer-events-auto');
        }
        galleryContainer.classList.remove('md:w-2/3', 'md:w-full');
      } else {
        // Desktop initial state: Panel open (translate-x-0), Gallery 2/3 width, Info hidden
        textPanel.classList.remove('translate-y-full', 'translate-y-0', 'md:translate-x-full');
        textPanel.classList.add('md:translate-x-0');
        galleryContainer.classList.remove('md:w-full');
        galleryContainer.classList.add('md:w-2/3');
        infoBtn.classList.add('opacity-0', 'pointer-events-none');
        infoBtn.classList.remove('opacity-100', 'pointer-events-auto');
      }
    }

    // Run on init
    initLayout();
    window.addEventListener('resize', initLayout);

    // If locked, we also hook into the submit listener to restore the info button if needed
    if (form && isLocked) {
      form.addEventListener('submit', () => {
        if (sessionStorage.getItem(`unlocked_project_${projectIdEl?.value}`) === 'true') {
          setTimeout(() => {
            initLayout();
          }, 600); // Wait for the transition to finish
        }
      });
    }

    // Click Close Button
    closeBtn.addEventListener('click', () => {
      if (isMobile()) {
        // Slide panel down
        textPanel.classList.add('translate-y-full');
        textPanel.classList.remove('translate-y-0');
      } else {
        // Slide panel right
        textPanel.classList.add('md:translate-x-full');
        textPanel.classList.remove('md:translate-x-0');
        // Expand gallery
        galleryContainer.classList.remove('md:w-2/3');
        galleryContainer.classList.add('md:w-full');
      }
      // Show Info button
      infoBtn.classList.remove('opacity-0', 'pointer-events-none');
      infoBtn.classList.add('opacity-100', 'pointer-events-auto');
    });

    // Click Info Button
    infoBtn.addEventListener('click', () => {
      if (isMobile()) {
        // Slide panel up
        textPanel.classList.remove('translate-y-full');
        textPanel.classList.add('translate-y-0');
      } else {
        // Slide panel left (show)
        textPanel.classList.remove('md:translate-x-full');
        textPanel.classList.add('md:translate-x-0');
        // Shrink gallery
        galleryContainer.classList.remove('md:w-full');
        galleryContainer.classList.add('md:w-2/3');
      }
      // Hide Info button
      infoBtn.classList.add('opacity-0', 'pointer-events-none');
      infoBtn.classList.remove('opacity-100', 'pointer-events-auto');
    });
  }
</script>
