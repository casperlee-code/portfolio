---
import Layout from '../layouts/Layout.astro';
import config from '../config.json';

const getAssetPath = (path: string) => path.startsWith('/') ? `${import.meta.env.BASE_URL}${path.slice(1)}` : path;

const educationGrades = [
  { semester: '3rd Year, 2nd Semester', gpa: '4.0', deptRank: '1', classRank: '1', cumRank: '1' },
  { semester: '3rd Year, 1st Semester', gpa: '3.9', deptRank: '3', classRank: '3', cumRank: '5' },
  { semester: '2nd Year, 2nd Semester', gpa: '3.8', deptRank: '5', classRank: '2', cumRank: '7' },
  { semester: '2nd Year, 1st Semester', gpa: '3.9', deptRank: '6', classRank: '3', cumRank: '11' },
  { semester: '1st Year, 2nd Semester', gpa: '3.8', deptRank: '12', classRank: '4', cumRank: '11' },
  { semester: '1st Year, 1st Semester', gpa: '3.5', deptRank: '10', classRank: '3', cumRank: '10' },
];

const awards = [
  {
    title: 'Merit Award',
    competition: '2025 R.O.C. Student Design Competition, National Architect Association of R.O.C.',
    date: 'Dec 2025'
  },
  {
    title: 'Third Place',
    competition: 'Distinguished Alumni Day × AI Book House 2026 Design Competition, Feng Chia University',
    date: 'Jan 2026'
  },
  {
    title: 'Third Place',
    competition: 'Sophomore Design Critique, Feng Chia University',
    date: 'Dec 2024 / Jun 2025'
  }
];

const experiences = [
  {
    role: 'Architectural Intern',
    company: 'SHIN Architects',
    location: 'Tokyo, Japan',
    date: 'Aug 2026',
    highlights: [
      'Contributed to the Takename Stadium grandstand project, focusing on large-span structural detailing.',
      'Built a full-scale physical model to test construction methods and structural integration.',
      'Immersed in Japanese design office culture and craftsmanship-driven workflow.'
    ]
  },
  {
    role: 'Architectural Intern',
    company: 'STOA International Architects Inc.',
    location: 'Houston, TX, USA',
    date: 'Jul – Aug 2025',
    highlights: [
      'Conducted Revit modeling, Lumion rendering, and AutoCAD drafting for the Fort Bend County Community Center and KMST Center projects.',
      'Gained insight into architectural scale, units, and design approaches within the U.S. urban context.'
    ]
  },
  {
    role: 'Architectural Intern',
    company: 'AS.studio Engineering Consultant',
    location: 'Tainan, Taiwan',
    date: 'Jan – Feb 2026',
    highlights: [
      'Assisted in roof structure design for the Tainan Railway Green Corridor bicycle bridge, using Rhino for 3D modeling.',
      'Produced physical structure models and presentation boards for the Chiayi City Library design competition.'
    ]
  },
  {
    role: 'Architectural Intern',
    company: 'Harmony Design Architects',
    location: 'Tainan, Taiwan',
    date: 'Jan – Feb 2025',
    highlights: [
      'Assisted in model-making and design discussions for a residential project in Taichung.',
      'Took part in preliminary site analysis for an elementary school gate guardhouse project.'
    ]
  },
  {
    role: 'Event Staff',
    company: 'FIABCI International Trade Mission 2026',
    location: 'Taichung, Taiwan',
    date: 'Sep 2026',
    highlights: [
      'Supported guest reception and event logistics during international business matchmaking sessions and keynote presentations.',
      'Gained first-hand exposure to how global real estate leaders exchange ideas.'
    ]
  },
  {
    role: 'Summer Workshop Student',
    company: 'POLI.design, Politecnico di Milano',
    location: 'Milan, Italy',
    date: 'Jun – Jul 2026',
    highlights: [
      'Designed a pop-up retail concept for a Taiwanese brand inside Milano Centrale train station.',
      'Explored transit-hub retail spatial efficiency and brand storytelling in a high-density commercial context.'
    ]
  },
  {
    role: 'Selected Participant',
    company: 'MOE Overseas Elite Training Program (菁培計畫)',
    location: 'Taiwan',
    date: 'Jul 2026',
    highlights: [
      'Selected through a nationwide competitive review process for an intensive cross-disciplinary design training program.',
      'Engaged in critique sessions with visiting professors and design professionals from overseas partner institutions.'
    ]
  },
  {
    role: 'Teaching Assistant (EMI Program)',
    company: 'Feng Chia University',
    location: 'Taichung, Taiwan',
    date: 'Sep 2025 – Present',
    highlights: [
      'Supported sophomore design studio development and classroom activities.',
      'Designed visual communication materials for FCU\'s Italian Week.'
    ]
  },
  {
    role: 'Assistant',
    company: 'Golden Pin Design Award: Student Observer Program',
    location: 'Taipei, Taiwan',
    date: 'Sep 2025',
    highlights: [
      'Assisted in exhibition setup, gaining hands-on experience in spatial curation.',
      'Observed the jury evaluation process during professional design assessment.'
    ]
  },
  {
    role: 'Deputy Director, Academic Division',
    company: 'Architecture Student Association, Feng Chia University',
    location: 'Taichung, Taiwan',
    date: 'Aug 2025 – Present',
    highlights: [
      'Organizes architect lectures connecting students with practicing professionals.'
    ]
  },
  {
    role: 'Student',
    company: 'AA Visiting School Taiwan — "Urbanity from the Ocean"',
    location: 'Yilan / Hualien, Taiwan',
    date: 'Aug 2024',
    highlights: [
      'Completed a 14-day field research and public exhibition program examining coastal ecological fragility through an indigenous cultural lens.'
    ]
  }
];

const skills = [
  { category: 'Architectural Modeling', items: 'Revit, Rhinoceros, AutoCAD, Grasshopper' },
  { category: 'Rendering', items: 'Lumion, D5 Render' },
  { category: 'Adobe Software', items: 'Illustrator, Photoshop, InDesign, Premiere Pro' },
  { category: 'Language Certificates', items: 'TOEFL iBT 92 | TOEIC 785 | BESTEP B2' }
];
---

<Layout title="About" description={`About Casper Ping-Kuan Lee — Architectural Portfolio & Resume`}>
  <div class="max-w-6xl mx-auto pt-32 md:pt-40 pb-24 px-6 md:px-12 min-h-screen flex flex-col md:flex-row gap-12 md:gap-16">
    
    <!-- Left Main Column: Full CV Content -->
    <div class="md:w-2/3 space-y-16">
      
      <!-- Profile Photo & H1 Header -->
      <div class="space-y-6">
        <div class="w-32 h-32 md:w-40 md:h-40 rounded-full overflow-hidden border border-neutral-200 shadow-sm bg-neutral-100">
          <img 
            src={getAssetPath('/大頭照.jpg')} 
            alt="Casper Ping-Kuan Lee" 
            class="w-full h-full object-cover"
          />
        </div>
        <div>
          <span class="text-xs tracking-[0.25em] uppercase text-neutral-400 font-semibold mb-2 block">About</span>
          <h1 class="text-3xl md:text-5xl font-light tracking-tight font-display text-neutral-900 leading-tight">
            CASPER PING-KUAN LEE
          </h1>
          <p class="text-sm md:text-base font-light tracking-widest text-neutral-500 uppercase mt-2">
            Taichung / Tainan, Taiwan
          </p>
        </div>
      </div>

      <!-- ## SUMMARY -->
      <section class="space-y-4">
        <h2 class="text-xs tracking-[0.25em] uppercase font-bold text-neutral-900 border-b border-neutral-200 pb-2 font-display">
          SUMMARY
        </h2>
        <p class="text-sm font-light leading-relaxed text-neutral-700">
          Fourth-year architecture student passionate about the intersection of architecture, computation, and international real estate development. Skilled in Revit, Rhino, Grasshopper, and BIM workflows developed across internships in three countries, with hands-on experience translating design concepts into buildable, resource-efficient outcomes. Brings integrated technical and cross-cultural skills strengthened through internships and study programs in the United States, Japan, Italy, and Taiwan.
        </p>
      </section>

      <!-- ## EDUCATION -->
      <section class="space-y-6">
        <h2 class="text-xs tracking-[0.25em] uppercase font-bold text-neutral-900 border-b border-neutral-200 pb-2 font-display">
          EDUCATION
        </h2>
        <div class="space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
            <h3 class="text-base font-medium text-neutral-900 font-display">
              Feng Chia University, Bachelor of Architecture Studies
            </h3>
            <span class="text-xs text-neutral-400 font-light whitespace-nowrap">Sep 2023 – Present</span>
          </div>

          <!-- Highlight Achievement -->
          <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-neutral-50 border border-neutral-200 text-xs text-neutral-800 font-medium">
            <span class="w-1.5 h-1.5 rounded-full bg-neutral-900"></span>
            Ranked 1st of 106 students, Department of Architecture
          </div>

          <!-- Academic Growth Trend (Line Chart) -->
          <div class="p-5 border border-neutral-200 bg-neutral-50/50 space-y-4 my-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-neutral-200/60 pb-3">
              <div>
                <h4 class="text-xs font-semibold uppercase tracking-wider text-neutral-900 font-display">
                  Academic Growth Trend (成績進步趨勢)
                </h4>
                <p class="text-[11px] text-neutral-500 font-light">
                  Continuous improvement over 6 semesters, reaching 4.0 GPA & #1 Dept Rank
                </p>
              </div>
              <!-- Interactive View Toggle Buttons -->
              <div class="flex items-center gap-1 bg-white border border-neutral-200 p-1 text-[10px] font-medium" id="chart-toggle-group">
                <button type="button" data-view="gpa" class="chart-tab-btn px-2.5 py-1 bg-neutral-900 text-white transition-colors cursor-pointer">GPA (3.5 → 4.0)</button>
                <button type="button" data-view="rank" class="chart-tab-btn px-2.5 py-1 text-neutral-600 hover:text-neutral-900 transition-colors cursor-pointer">Dept Rank (#10 → #1)</button>
                <button type="button" data-view="both" class="chart-tab-btn px-2.5 py-1 text-neutral-600 hover:text-neutral-900 transition-colors cursor-pointer">Both</button>
              </div>
            </div>

            <!-- Responsive Line Chart SVG -->
            <div class="w-full overflow-x-auto">
              <svg viewBox="0 0 600 210" class="w-full min-w-[500px] h-auto font-sans text-neutral-600 select-none">
                <!-- Background Grid Lines -->
                <line x1="50" y1="30" x2="550" y2="30" stroke="#e5e5e5" stroke-dasharray="3 3" />
                <line x1="50" y1="75" x2="550" y2="75" stroke="#e5e5e5" stroke-dasharray="3 3" />
                <line x1="50" y1="120" x2="550" y2="120" stroke="#e5e5e5" stroke-dasharray="3 3" />
                <line x1="50" y1="165" x2="550" y2="165" stroke="#e5e5e5" stroke-linecap="round" stroke-width="1" />

                <!-- Left Y-Axis Labels (GPA) -->
                <g class="gpa-axis-labels text-[9px] fill-neutral-400 font-mono">
                  <text x="42" y="33" text-anchor="end">4.0</text>
                  <text x="42" y="78" text-anchor="end">3.8</text>
                  <text x="42" y="123" text-anchor="end">3.6</text>
                  <text x="42" y="168" text-anchor="end">3.4</text>
                </g>

                <!-- Right Y-Axis Labels (Rank) -->
                <g class="rank-axis-labels text-[9px] fill-neutral-400 font-mono hidden" id="rank-y-labels">
                  <text x="558" y="33" text-anchor="start">#1</text>
                  <text x="558" y="78" text-anchor="start">#5</text>
                  <text x="558" y="123" text-anchor="start">#9</text>
                  <text x="558" y="168" text-anchor="start">#13</text>
                </g>

                <!-- X-Axis Semester Labels -->
                <g class="text-[10px] fill-neutral-500 font-medium">
                  <text x="60" y="186" text-anchor="middle">1Y 1S</text>
                  <text x="158" y="186" text-anchor="middle">1Y 2S</text>
                  <text x="256" y="186" text-anchor="middle">2Y 1S</text>
                  <text x="354" y="186" text-anchor="middle">2Y 2S</text>
                  <text x="452" y="186" text-anchor="middle">3Y 1S</text>
                  <text x="550" y="186" text-anchor="middle">3Y 2S</text>
                </g>

                <!-- Gradient Fill Definitions -->
                <defs>
                  <linearGradient id="gpaGradient" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#171717" stop-opacity="0.15" />
                    <stop offset="100%" stop-color="#171717" stop-opacity="0.0" />
                  </linearGradient>
                  <linearGradient id="rankGradient" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#2563eb" stop-opacity="0.15" />
                    <stop offset="100%" stop-color="#2563eb" stop-opacity="0.0" />
                  </linearGradient>
                </defs>

                <!-- Area Under GPA Line -->
                <path id="gpa-area" d="M 60,142.5 L 60,142.5 L 158,75 L 256,52.5 L 354,75 L 452,52.5 L 550,30 L 550,165 L 60,165 Z" fill="url(#gpaGradient)" class="transition-opacity duration-300" />

                <!-- GPA Line Path -->
                <path id="gpa-line" d="M 60,142.5 L 158,75 L 256,52.5 L 354,75 L 452,52.5 L 550,30" fill="none" stroke="#171717" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-all duration-300" />

                <!-- GPA Dots & Value Labels -->
                <g id="gpa-dots" class="transition-opacity duration-300">
                  <circle cx="60" cy="142.5" r="4" fill="#ffffff" stroke="#171717" stroke-width="2.5" />
                  <text x="60" y="132" text-anchor="middle" class="text-[10px] font-semibold font-mono fill-neutral-900">3.5</text>
                  
                  <circle cx="158" cy="75" r="4" fill="#ffffff" stroke="#171717" stroke-width="2.5" />
                  <text x="158" y="65" text-anchor="middle" class="text-[10px] font-semibold font-mono fill-neutral-900">3.8</text>

                  <circle cx="256" cy="52.5" r="4" fill="#ffffff" stroke="#171717" stroke-width="2.5" />
                  <text x="256" y="42.5" text-anchor="middle" class="text-[10px] font-semibold font-mono fill-neutral-900">3.9</text>

                  <circle cx="354" cy="75" r="4" fill="#ffffff" stroke="#171717" stroke-width="2.5" />
                  <text x="354" y="65" text-anchor="middle" class="text-[10px] font-semibold font-mono fill-neutral-900">3.8</text>

                  <circle cx="452" cy="52.5" r="4" fill="#ffffff" stroke="#171717" stroke-width="2.5" />
                  <text x="452" y="42.5" text-anchor="middle" class="text-[10px] font-semibold font-mono fill-neutral-900">3.9</text>

                  <circle cx="550" cy="30" r="5" fill="#171717" stroke="#ffffff" stroke-width="2" />
                  <text x="550" y="20" text-anchor="middle" class="text-[11px] font-bold font-mono fill-neutral-900">4.0 ★</text>
                </g>

                <!-- Department Rank Line Path -->
                <path id="rank-area" d="M 60,116.8 L 158,136.1 L 256,78.2 L 354,68.6 L 452,49.3 L 550,30 L 550,165 L 60,165 Z" fill="url(#rankGradient)" class="transition-opacity duration-300 opacity-0" />

                <path id="rank-line" d="M 60,116.8 L 158,136.1 L 256,78.2 L 354,68.6 L 452,49.3 L 550,30" fill="none" stroke="#2563eb" stroke-width="2" stroke-dasharray="4 3" stroke-linecap="round" stroke-linejoin="round" class="transition-all duration-300 opacity-0" />

                <g id="rank-dots" class="transition-opacity duration-300 opacity-0">
                  <circle cx="60" cy="116.8" r="3.5" fill="#ffffff" stroke="#2563eb" stroke-width="2" />
                  <text x="60" y="108" text-anchor="middle" class="text-[10px] font-semibold font-mono fill-blue-600">#10</text>

                  <circle cx="158" cy="136.1" r="3.5" fill="#ffffff" stroke="#2563eb" stroke-width="2" />
                  <text x="158" y="128" text-anchor="middle" class="text-[10px] font-semibold font-mono fill-blue-600">#12</text>

                  <circle cx="256" cy="78.2" r="3.5" fill="#ffffff" stroke="#2563eb" stroke-width="2" />
                  <text x="256" y="70" text-anchor="middle" class="text-[10px] font-semibold font-mono fill-blue-600">#6</text>

                  <circle cx="354" cy="68.6" r="3.5" fill="#ffffff" stroke="#2563eb" stroke-width="2" />
                  <text x="354" y="60" text-anchor="middle" class="text-[10px] font-semibold font-mono fill-blue-600">#5</text>

                  <circle cx="452" cy="49.3" r="3.5" fill="#ffffff" stroke="#2563eb" stroke-width="2" />
                  <text x="452" y="41" text-anchor="middle" class="text-[10px] font-semibold font-mono fill-blue-600">#3</text>

                  <circle cx="550" cy="30" r="4.5" fill="#2563eb" stroke="#ffffff" stroke-width="2" />
                  <text x="550" y="18" text-anchor="middle" class="text-[11px] font-bold font-mono fill-blue-600">#1 🏆</text>
                </g>
              </svg>
            </div>
            
            <!-- Legend bar -->
            <div class="flex items-center justify-between text-[11px] text-neutral-500 font-light border-t border-neutral-200/50 pt-2 px-1">
              <div class="flex items-center gap-4">
                <span class="inline-flex items-center gap-1.5">
                  <span class="w-3 h-0.5 bg-neutral-900 inline-block"></span> GPA Score (Out of 4.0)
                </span>
                <span class="inline-flex items-center gap-1.5">
                  <span class="w-3 h-0.5 border-t border-dashed border-blue-600 inline-block"></span> Department Rank (#10 → #1)
                </span>
              </div>
              <span class="text-[10px] text-neutral-400 font-mono">FCU Architecture</span>
            </div>
          </div>

          <!-- Grades & Rankings Table -->
          <div class="pt-2">
            <p class="text-[11px] tracking-wider uppercase text-neutral-400 font-semibold mb-3">
              Academic Record (GPA & Ranking Breakdown)
            </p>
            <div class="overflow-x-auto border border-neutral-100">
              <table class="w-full text-left text-xs font-light">
                <thead>
                  <tr class="bg-neutral-50 text-neutral-500 border-b border-neutral-100 text-[10px] tracking-widest uppercase">
                    <th class="py-2.5 px-3">Semester</th>
                    <th class="py-2.5 px-3">GPA</th>
                    <th class="py-2.5 px-3">Dept Rank</th>
                    <th class="py-2.5 px-3">Class Rank</th>
                    <th class="py-2.5 px-3">Cumulative Dept Rank</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-neutral-100 text-neutral-700">
                  {educationGrades.map((row) => (
                    <tr class="hover:bg-neutral-50/50 transition-colors">
                      <td class="py-2.5 px-3 font-medium text-neutral-900">{row.semester}</td>
                      <td class="py-2.5 px-3">{row.gpa}</td>
                      <td class="py-2.5 px-3">{row.deptRank}</td>
                      <td class="py-2.5 px-3">{row.classRank}</td>
                      <td class="py-2.5 px-3">{row.cumRank}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </section>

      <!-- ## AWARDS & COMPETITIONS -->
      <section class="space-y-6">
        <h2 class="text-xs tracking-[0.25em] uppercase font-bold text-neutral-900 border-b border-neutral-200 pb-2 font-display">
          AWARDS & COMPETITIONS
        </h2>
        <div class="space-y-4">
          {awards.map((award) => (
            <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-1 border-l-2 border-neutral-200 pl-4 py-0.5">
              <div>
                <span class="text-xs font-semibold tracking-wider text-neutral-900 uppercase block font-display">
                  {award.title}
                </span>
                <p class="text-xs text-neutral-600 font-light mt-0.5">
                  {award.competition}
                </p>
              </div>
              <span class="text-xs text-neutral-400 font-light whitespace-nowrap sm:text-right">
                {award.date}
              </span>
            </div>
          ))}
        </div>
      </section>

      <!-- ## PROFESSIONAL EXPERIENCE -->
      <section class="space-y-8">
        <h2 class="text-xs tracking-[0.25em] uppercase font-bold text-neutral-900 border-b border-neutral-200 pb-2 font-display">
          PROFESSIONAL EXPERIENCE
        </h2>
        <div class="space-y-8">
          {experiences.map((exp) => (
            <div class="space-y-2">
              <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                <h3 class="text-sm font-semibold text-neutral-900 font-display">
                  {exp.role} <span class="font-light text-neutral-400 mx-1.5">|</span> {exp.company}
                </h3>
                <span class="text-xs text-neutral-400 font-light whitespace-nowrap">
                  {exp.date}
                </span>
              </div>
              <p class="text-xs text-neutral-500 font-light tracking-wide uppercase">
                {exp.location}
              </p>
              <ul class="space-y-1.5 pt-1 text-xs text-neutral-600 font-light list-disc list-inside">
                {exp.highlights.map((item) => (
                  <li class="leading-relaxed pl-1">
                    <span class="-ml-1">{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <!-- ## SKILLS -->
      <section class="space-y-6">
        <h2 class="text-xs tracking-[0.25em] uppercase font-bold text-neutral-900 border-b border-neutral-200 pb-2 font-display">
          SKILLS
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {skills.map((skill) => (
            <div class="p-4 border border-neutral-100 bg-neutral-50/50 space-y-1">
              <h3 class="text-[11px] tracking-wider uppercase font-semibold text-neutral-400 font-display">
                {skill.category}
              </h3>
              <p class="text-xs font-light text-neutral-800">
                {skill.items}
              </p>
            </div>
          ))}
        </div>
      </section>

      <!-- ## CERTIFICATIONS -->
      <section class="space-y-4">
        <h2 class="text-xs tracking-[0.25em] uppercase font-bold text-neutral-900 border-b border-neutral-200 pb-2 font-display">
          CERTIFICATIONS
        </h2>
        <div class="p-4 border border-neutral-100 bg-neutral-50/50 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <div>
            <h3 class="text-xs font-semibold text-neutral-900 font-display">
              Autodesk Revit Architecture Certified User
            </h3>
            <p class="text-[11px] text-neutral-500 font-light mt-0.5">
              Autodesk Official Certification
            </p>
          </div>
          <span class="text-xs font-medium text-neutral-700 bg-neutral-100 border border-neutral-200 px-3 py-1.5 w-fit rounded-none font-mono">
            取得日期: 2026/6
          </span>
        </div>
      </section>

    </div>

    <!-- Right Column: Sidebar (Contact, Socials, CV Download) -->
    <div class="md:w-1/3">
      <div class="sticky top-28 space-y-10 md:border-l md:border-neutral-100 md:pl-10">
        
        <!-- Contact Info -->
        <div class="space-y-3">
          <h3 class="text-[10px] tracking-[0.2em] uppercase text-neutral-400 font-semibold font-display">Contact</h3>
          <div class="space-y-3 text-xs font-light text-neutral-800">
            <div>
              <span class="text-neutral-400 block text-[9px] tracking-widest uppercase mb-0.5">Email</span>
              <a href={`mailto:${config.about.email}`} class="hover:text-neutral-500 transition-colors duration-300">
                {config.about.email}
              </a>
            </div>
            <div>
              <span class="text-neutral-400 block text-[9px] tracking-widest uppercase mb-0.5">Phone</span>
              <a href={`tel:${config.about.phone}`} class="hover:text-neutral-500 transition-colors duration-300">
                {config.about.phone}
              </a>
            </div>
          </div>
        </div>

        <!-- Socials -->
        <div class="space-y-3">
          <h3 class="text-[10px] tracking-[0.2em] uppercase text-neutral-400 font-semibold font-display">Socials</h3>
          <div class="flex flex-col gap-2">
            {config.socials.map((social) => (
              <a 
                href={social.url} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="text-xs font-light text-neutral-800 hover:text-neutral-500 transition-colors duration-300 w-fit"
              >
                {social.name}
              </a>
            ))}
          </div>
        </div>

        <!-- CV Download -->
        <div class="pt-2">
          <a 
            href={getAssetPath(config.about.cvUrl)} 
            download
            class="inline-block border border-neutral-900 text-neutral-900 hover:bg-neutral-900 hover:text-white text-[10px] tracking-[0.25em] uppercase px-6 py-3.5 font-semibold transition-all duration-300 rounded-none w-full text-center"
          >
            Download CV (PDF)
          </a>
        </div>

      </div>
    </div>

  </div>
</Layout>

<script>
  const toggleGroup = document.getElementById('chart-toggle-group');
  if (toggleGroup) {
    const btns = toggleGroup.querySelectorAll('.chart-tab-btn');
    const gpaLine = document.getElementById('gpa-line');
    const gpaArea = document.getElementById('gpa-area');
    const gpaDots = document.getElementById('gpa-dots');
    const rankLine = document.getElementById('rank-line');
    const rankArea = document.getElementById('rank-area');
    const rankDots = document.getElementById('rank-dots');
    const rankYLabels = document.getElementById('rank-y-labels');

    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const view = btn.getAttribute('data-view');
        
        btns.forEach(b => {
          b.classList.remove('bg-neutral-900', 'text-white');
          b.classList.add('text-neutral-600');
        });
        btn.classList.add('bg-neutral-900', 'text-white');
        btn.classList.remove('text-neutral-600');

        if (view === 'gpa') {
          gpaLine?.classList.remove('opacity-0');
          gpaArea?.classList.remove('opacity-0');
          gpaDots?.classList.remove('opacity-0');
          rankLine?.classList.add('opacity-0');
          rankArea?.classList.add('opacity-0');
          rankDots?.classList.add('opacity-0');
          rankYLabels?.classList.add('hidden');
        } else if (view === 'rank') {
          gpaLine?.classList.add('opacity-0');
          gpaArea?.classList.add('opacity-0');
          gpaDots?.classList.add('opacity-0');
          rankLine?.classList.remove('opacity-0');
          rankArea?.classList.remove('opacity-0');
          rankDots?.classList.remove('opacity-0');
          rankYLabels?.classList.remove('hidden');
        } else if (view === 'both') {
          gpaLine?.classList.remove('opacity-0');
          gpaArea?.classList.remove('opacity-0');
          gpaDots?.classList.remove('opacity-0');
          rankLine?.classList.remove('opacity-0');
          rankArea?.classList.remove('opacity-0');
          rankDots?.classList.remove('opacity-0');
          rankYLabels?.classList.remove('hidden');
        }
      });
    });
  }
</script>
